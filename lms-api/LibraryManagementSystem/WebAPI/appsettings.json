{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/applog-.json",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "shared": true,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithProcessId", "WithThreadId" ],
    "Properties": {
      "ApplicationName": "LMS"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "LibraryDb": "Server=localhost; Database=LMS; User Id=sa; Password=p@ssw0rd; TrustServerCertificate=True;"
  },
  "Jwt": {
    "Secret": "8fK3vQ9xL2mN7pR4tY6wA1sD5gH9jC2zX8bV4nM6qP3rT7uW",
    "ExpirationInMinutes": 10,
    "Issuer": "LMS",
    "Audience": "account"
  },
  "ClientUrl": "https://localhost:4200"
}
